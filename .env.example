# Nivoda API Credentials
# Copy this file to .env and fill in your credentials

# For testing with STAGING environment (recommended first):
NIVODA_USERNAME=testaccount@sample.com
NIVODA_PASSWORD=staging-nivoda-22
NIVODA_USE_STAGING=true

# For PRODUCTION (once testing is complete and production is activated):
# NIVODA_USERNAME=your_email@example.com
# NIVODA_PASSWORD=your_password
# NIVODA_USE_STAGING=false

# NOTE: API access must be enabled by Nivoda support before use
# See NIVODA_API_ACCESS_REQUEST.md for instructions
